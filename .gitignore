```yaml
# Ansible roles and playbooks typically don't generate build artifacts,
# but we'll include common ignores for completeness

# Logs and temp files
*.log
*.tmp
*.swp

# Environment files
.env
.env.local
.env.*

.vscode/
.idea/

# Python (if any Python scripts are used alongside Ansible)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Coverage reports
.coverage
htmlcov/
.coverage.*
.nyc_output

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
```
